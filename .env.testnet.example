# Copy this file to .env.testnet and fill in your own values.
# .env.testnet is gitignored — DO NOT commit real keys.

# --- Identity ---
# Bech32-encoded Ed25519 private key, prefix "suiprivkey1...".
# Generate one with: pnpm tsx scripts/gen-testnet-wallet.ts
SUI_PRIVATE_KEY=suiprivkey1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Network ---
# 'testnet' or 'mainnet'. The spike defaults to testnet.
SUI_NETWORK=testnet

# Comma-separated list of Sui JSON-RPC URLs. First entry is primary.
SUI_RPC_URLS=https://fullnode.testnet.sui.io:443

# --- sui-stack-messaging ---
# Comma-separated Seal key server object IDs for testnet.
# Source: sui-stack-messaging/chat-app/.env (Mysten reference deployment).
SEAL_SERVERS=0x73d05d62c18d9374e3ea529e8e0ed6161da1a141a94d3f76ae3fe4e99356db75,0xf5d14a81a982144ae441cd7d64b09027f116a468bd36e7eca494f750591623c8

# Optional. Unset = serverless transport (Sui channel_log + Walrus). Set it only to
# use a self-hosted relayer from https://github.com/MystenLabs/sui-stack-messaging/tree/main/relayer
# RELAYER_URL=http://localhost:3000

# --- Walrus (used when attachments are enabled) ---
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# --- Local state ---
LOG_DIR=$HOME/.walrus-agent-stack/log
